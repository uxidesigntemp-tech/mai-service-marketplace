# MAI Service Marketplace - Environment Variables Configuration
# Copy this file to .env and fill in your production values

# Application
NODE_ENV=development
PORT=5000
APP_NAME="MAI Service"
APP_URL=http://localhost:5000

# Authentication & Security
SESSION_SECRET=mai_services_super_secret_jwt_and_session_key_2026_production
COOKIE_SECRET=mai_services_cookie_secret_key_production
CORS_ORIGIN=http://localhost:5000

# Database Configuration (PostgreSQL / Prisma)
# When PostgreSQL is installed and provisioned:
DATABASE_URL="postgresql://mai_user:mai_secure_password@localhost:5432/mai_service_db?schema=public"

# Payment Gateway (e.g., Stripe)
# When real Stripe keys are configured, webhook signature verification is enabled
STRIPE_SECRET_KEY=sk_test_example_mai_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_example_mai_pub_key
STRIPE_WEBHOOK_SECRET=whsec_example_mai_webhook_secret

# Email Service (e.g., SendGrid / AWS SES / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=example_user
SMTP_PASS=example_pass
EMAIL_FROM="MAI Service <support@myproject.ai>"

# File Storage (Optional AWS S3 / Cloudinary)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
AWS_S3_BUCKET=mai-service-uploads
